[Unit]
Description=Yoriai local LLM agent discovery
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKING_DIR__
ExecStart=__PYTHON_BIN__ __YORIAI_SCRIPT__
Restart=on-failure
RestartSec=5
StandardOutput=append:__LOG_DIR__/agent.log
StandardError=append:__LOG_DIR__/agent.error.log

[Install]
WantedBy=multi-user.target
